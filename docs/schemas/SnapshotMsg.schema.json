        "carrying": {
          "type": "integer"
        },
        "facing": {
          "type": "integer"
        },
        "hidden": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "facing",
        "state",
        "action",
        "carrying",
        "hidden"
      ],
      "type": "object"
    },
    "BldState": {
      "additionalProperties": false,
