    "SnapshotMsg": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentView"
          },
          "type": "array"
        },
        "buildings": {
          "items": {
            "$ref": "#/$defs/BldState"
          },
          "type": "array"
        },
        "day": {
          "type": "integer"
        },
        "domain": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "hour": {
          "type": "number"
        },
        "jobs": {
          "items": {
            "$ref": "#/$defs/JobView"
          },
          "type": "array"
        },
        "paused": {
          "type": "boolean"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResState"
          },
          "type": "array"
        },
        "season": {
          "type": "string"
        },
        "stats": {
          "$ref": "#/$defs/Stats"
        },
