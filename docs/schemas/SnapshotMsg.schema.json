        "id": {
          "type": "string"
        },
        "issued_by": {
          "type": "string"
        },
        "issued_by_name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "priority",
        "status",
        "claimed_by",
        "note",
        "issued_by",
        "issued_by_name"
      ],
      "type": "object"
    },
    "ResState": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "integer"
